+package tv.own.owntv.core.sports
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import tv.own.owntv.core.sports.model.Broadcast
+import tv.own.owntv.core.sports.model.Competitor
+import tv.own.owntv.core.sports.model.League
+import tv.own.owntv.core.sports.model.Match
+import tv.own.owntv.core.sports.model.MatchState
+import tv.own.owntv.core.sports.model.Sport
+import tv.own.owntv.core.sports.model.Team
+
+class CompetitionNamesTest {
+    private fun match(sport: Sport, slug: String, espnName: String, sides: List<Team> = emptyList(), broadcasts: List<String> = emptyList()) = Match(
+        id = "1", sport = sport, feed = League.keyOf(sport, slug), leagueSlug = slug, leagueName = espnName,
+        startMs = 0, state = MatchState.PRE, statusText = "", title = "",
+        competitors = sides.mapIndexed { i, t -> Competitor(t, home = i == 0, winner = null, score = null) },
+        broadcasts = broadcasts.map { Broadcast(it) },
+    )
+
+
+    @Test fun formulaOneDoesNotMatchFormulaE() {
+        val k=WatchMatcher.Keys(match(Sport.RACING,"f1","Formula 1"))
+        assertFalse(WatchMatcher.isLikely(k,"Formula E"))
+        assertTrue(WatchMatcher.isLikely(k,"Sky Sports F1"))
+        assertEquals(WatchMatcher.Hit.NONE, WatchMatcher.hit(k, TeamNames.tokens("Formula E").toSet(), CompetitionNames.words("Formula E")))
+    }
+    @Test fun premierLeagueDoesNotMatchIndianPremierLeague() {
+        val k=WatchMatcher.Keys(match(Sport.SOCCER,"eng.1","Premier League"))
+        assertFalse(WatchMatcher.isLikely(k,"Indian Premier League"))
+        assertTrue(WatchMatcher.isLikely(k,"Premier League"))
+    }
+    @Test fun broadcasterOwnershipDoesNotPromoteUnrelatedSeries() {
+        val k=WatchMatcher.Keys(match(Sport.SOCCER,"eng.1","Premier League", broadcasts=listOf("Apple TV")))
+        assertFalse(WatchMatcher.isLikely(k,"Apple TV+ Series 1"))
+        assertTrue(WatchMatcher.isLikely(k,"Apple TV Event 3"))
+    }
+}
