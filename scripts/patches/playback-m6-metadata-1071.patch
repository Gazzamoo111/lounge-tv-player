+package tv.own.owntv.core.metadata
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+
+class EnglishPosterTest {
+    private fun art(path: String, language: String?, width: Int) = JSONObject().put("file_path", path)
+        .put("iso_639_1", language ?: JSONObject.NULL).put("width", width)
+    @Test fun `English beats foreign and textless artwork then highest resolution wins`() {
+        val images = JSONArray().put(art("/fr.jpg", "fr", 3000)).put(art("/neutral.jpg", null, 2000))
+            .put(art("/en-low.jpg", "en", 500)).put(art("/en-high.jpg", "en", 2000))
+        assertEquals("/en-high.jpg", EnglishPoster.select(images, "/original.jpg"))
+        assertEquals("/neutral.jpg", EnglishPoster.select(JSONArray().put(art("/fr.jpg", "fr", 3000)).put(art("/neutral.jpg", null, 2000)), "/original.jpg"))
+    }
+    @Test fun `correct foreign original remains fallback when no English or textless alternative exists`() {
+        assertEquals("/original.jpg", EnglishPoster.select(JSONArray().put(art("/fr.jpg", "fr", 1000)), "/original.jpg"))
+        assertEquals("/fr.jpg", EnglishPoster.select(JSONArray().put(art("/fr.jpg", "fr", 1000)), null))
+        assertNull(EnglishPoster.select(null, null))
+        assertEquals("/original.jpg", EnglishPoster.select(JSONArray(), "/original.jpg"))
+    }
+    @Test fun `new artwork policy cannot read an old language poster cache and language remains isolated`() {
+        assertNotEquals("movie:10", MetadataRepository.cacheKey(10))
+        assertNotEquals(MetadataRepository.cacheKey(10, "en"), MetadataRepository.cacheKey(10, "fr"))
+        assertNotEquals(MetadataRepository.cacheKey(10), MetadataRepository.tvCacheKey(10))
+    }
+}
