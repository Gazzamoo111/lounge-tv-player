+package tv.own.owntv.core.metadata
+
+import org.json.JSONArray
+
+/** Image-only policy. Entries all belong to the already resolved TMDB identity. */
+internal object EnglishPoster {
+    fun select(images: JSONArray?, fallback: String?): String? {
+        if (images == null) return fallback
+        data class Image(val path: String, val rank: Int, val width: Int)
+        val candidates = (0 until images.length()).mapNotNull { index ->
+            val image = images.optJSONObject(index) ?: return@mapNotNull null
+            val path = image.optString("file_path").takeIf { it.startsWith("/") } ?: return@mapNotNull null
+            val language = image.optString("iso_639_1").takeUnless { it.isBlank() || it == "null" }
+            val rank = when (language) { "en" -> 0; null -> 1; else -> 2 }
+            Image(path, rank, image.optInt("width", 0))
+        }
+        val best = candidates.minWithOrNull(compareBy<Image> { it.rank }.thenByDescending { it.width })
+        return if (best != null && best.rank < 2) best.path else fallback ?: best?.path
+    }
+}
