@@ -0,0 +1,23 @@
+package tv.own.owntv.core.sports
+
+import org.junit.Test
+import org.junit.Assert.*
+import tv.own.owntv.core.sports.model.*
+
+class SportsBrandColorTest {
+    private fun teams(color: String) = EspnParser.teams("""{"sports":[{"leagues":[{"teams":[{"team":{"id":"1","displayName":"TEST club","color":"$color"}}]}]}]}""")
+    @Test fun `source colour is retained without inventing a palette`() {
+        assertEquals("E31837", teams("E31837").single().color)
+        assertNull(teams("").single().color)
+    }
+    @Test fun `invalid source colours are discarded`() {
+        for (invalid in listOf("red", "#E31837", "GG0000", "1234567")) assertNull(teams(invalid).single().color)
+    }
+    @Test fun `colour and team identity survive stored fixture round trip`() {
+        val team = teams("E31837").single()
+        val match = Match("test", Sport.SOCCER, "soccer/eng.1", "eng.1", "TEST competition", 1000, MatchState.PRE, "", "TEST fixture",
+            competitors = listOf(Competitor(team, true, null, null)))
+        val board = SportsBoard(today = mapOf("soccer/eng.1" to listOf(match)))
+        assertEquals(team, SportsCacheJson.read(SportsCacheJson.write(board))!!.matches.single().competitors.single().team)
+    }
+}
