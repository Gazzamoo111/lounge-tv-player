+/** A stalled token service must not hold either engine's recovery pending indefinitely. */
+internal suspend fun resolvePlaybackRecoveryUrl(
+    provider: tv.own.owntv.core.stalker.ReconnectUrlProvider?,
+    timeoutMs: Long = 8_000L,
+): String? {
+    if (provider == null) return null
+    return kotlinx.coroutines.withTimeoutOrNull(timeoutMs) {
+        try { provider.freshUrl() }
+        catch (cancel: kotlinx.coroutines.CancellationException) { throw cancel }
+        catch (_: Exception) { null }
+    }
+}
+
+/** URL resolution and retry backoff run together, rather than charging both waits. */
+internal fun remainingRecoveryDelay(delayMs: Long, startedMs: Long, nowMs: Long): Long =
+    (delayMs - (nowMs - startedMs).coerceAtLeast(0L)).coerceAtLeast(0L)
