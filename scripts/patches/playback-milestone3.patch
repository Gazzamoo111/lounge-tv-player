+++ b/core/src/test/java/tv/own/owntv/core/network/HttpCancellationIntegrationTest.kt
@@ -0,0 +1,79 @@
+package tv.own.owntv.core.network
+
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicReference
+import kotlinx.coroutines.*
+import okhttp3.Call
+import okhttp3.EventListener
+import okhttp3.OkHttpClient
+import org.junit.Assert.*
+import org.junit.Test
+
+/** Real localhost HTTP sockets, not a mocked transport or provider stream. */
+class HttpCancellationIntegrationTest {
+    private class SilentServer : AutoCloseable {
+        private val server = ServerSocket(0)
+        private val socket = AtomicReference<Socket?>()
+        val received = CountDownLatch(1)
+        val closed = CountDownLatch(1)
+        val url = "http://127.0.0.1:${server.localPort}/resolve"
+        init {
+            Thread({
+                try {
+                    server.accept().use { client ->
+                        socket.set(client)
+                        val input = client.getInputStream().bufferedReader()
+                        while (!input.readLine().isNullOrEmpty()) { }
+                        received.countDown()
+                        if (input.read() == -1) closed.countDown()
+                    }
+                } catch (_: Exception) { }
+            }, "m3-silent-http-test").apply { isDaemon = true; start() }
+        }
+        override fun close() { socket.get()?.close(); server.close() }
+    }
+    private fun client() = OkHttpClient.Builder().readTimeout(30, TimeUnit.SECONDS).build()
+
+    @Test(timeout = 10_000) fun `cancelled URL or metadata fetch closes blocked real socket promptly`() = runBlocking {
+        SilentServer().use { server ->
+            val client = client()
+            try {
+                val request = async(Dispatchers.Default) { HttpClient(client).getText(server.url) }
+                assertTrue(withContext(Dispatchers.IO) { server.received.await(3, TimeUnit.SECONDS) })
+                request.cancelAndJoin()
+                assertTrue(withContext(Dispatchers.IO) { server.closed.await(3, TimeUnit.SECONDS) })
+                assertTrue(request.isCancelled)
+            } finally { client.dispatcher.executorService.shutdown(); client.connectionPool.evictAll() }
+        }
+    }
+    @Test(timeout = 10_000) fun `recovery timeout interrupts blocked HTTP instead of waiting for socket read timeout`() = runBlocking {
+        SilentServer().use { server ->
+            val client = client()
+            try {
+                val result = withTimeoutOrNull(1_000) { HttpClient(client).getText(server.url) }
+                assertNull(result)
+                assertTrue(withContext(Dispatchers.IO) { server.closed.await(3, TimeUnit.SECONDS) })
+            } finally { client.dispatcher.executorService.shutdown(); client.connectionPool.evictAll() }
+        }
+    }
+    @Test(timeout = 10_000) fun `successful response does not trigger call cancellation`() = runBlocking {
+        ServerSocket(0).use { server ->
+            var cancelled = 0
+            val client = OkHttpClient.Builder().eventListener(object : EventListener() {
+                override fun canceled(call: Call) { cancelled++ }
+            }).build()
+            Thread({ server.accept().use { socket ->
+                val input = socket.getInputStream().bufferedReader()
+                while (!input.readLine().isNullOrEmpty()) { }
+                socket.getOutputStream().write("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK".toByteArray())
+            } }, "m3-success-http-test").apply { isDaemon = true; start() }
+            try {
+                assertEquals("OK", HttpClient(client).getText("http://127.0.0.1:${server.localPort}/ok"))
+                assertEquals(0, cancelled)
+            } finally { client.dispatcher.executorService.shutdown(); client.connectionPool.evictAll() }
+        }
+    }
+}
