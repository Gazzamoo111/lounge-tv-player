+package tv.own.owntv.player
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.test.*
+import org.junit.Assert.*
+import org.junit.Test
+import tv.own.owntv.core.stalker.ReconnectUrlProvider
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class RecoveryResolutionTest {
+    @Test fun `silent URL service times out so the existing bounded ladder can continue`() = runTest {
+        var released = false
+        val result = async { resolvePlaybackRecoveryUrl(ReconnectUrlProvider {
+            try { awaitCancellation() } finally { released = true }
+        }) }
+        advanceTimeBy(7_999); assertFalse(result.isCompleted)
+        advanceTimeBy(2); runCurrent()
+        assertNull(result.await()); assertTrue(released)
+    }
+    @Test fun `stop or a replacement tune cancels URL work and publishes nothing`() = runTest {
+        var applied = false
+        var released = false
+        val job = async {
+            resolvePlaybackRecoveryUrl(ReconnectUrlProvider { try { awaitCancellation() } finally { released = true } })
+            applied = true
+        }
+        runCurrent(); job.cancel(); runCurrent()
+        assertFalse(applied); assertTrue(released)
+    }
+    @Test fun `valid refreshed URL reaches the engine unchanged`() = runTest {
+        assertEquals("new-token", resolvePlaybackRecoveryUrl(ReconnectUrlProvider { "new-token" }))
+    }
+    @Test fun `transport failure and absent provider fall back to the stored URL`() = runTest {
+        assertNull(resolvePlaybackRecoveryUrl(ReconnectUrlProvider { error("offline") }))
+        assertNull(resolvePlaybackRecoveryUrl(null))
+    }
+    @Test fun `backoff and slow URL resolve overlap instead of stacking`() = runTest {
+        val start = testScheduler.currentTime
+        val fresh = resolvePlaybackRecoveryUrl(ReconnectUrlProvider { kotlinx.coroutines.delay(2_000); "fresh" })
+        kotlinx.coroutines.delay(remainingRecoveryDelay(1_500, start, testScheduler.currentTime))
+        assertEquals("fresh", fresh)
+        assertEquals(2_000, testScheduler.currentTime - start)
+        // Before: 2,000 ms resolution + 1,500 ms backoff = 3,500 ms under identical conditions.
+    }
+    @Test fun `fast resolution still honours provider backoff and clock regressions`() {
+        assertEquals(3_000, remainingRecoveryDelay(3_500, 10_000, 10_500))
+        assertEquals(0, remainingRecoveryDelay(1_500, 10_000, 15_000))
+        assertEquals(1_500, remainingRecoveryDelay(1_500, 10_000, 9_000))
+    }
+}
