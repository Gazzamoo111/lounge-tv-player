+package tv.own.owntv.core.database.dao
+
+/** Shared SQL for paged browsing, guide parity and playback snapshots. Explicit moves sort first. */
+object ChannelEditorialSql {
+    const val TIER = "CASE WHEN UPPER(c.name) LIKE '% BACKUP%' OR UPPER(c.name) LIKE '%(BK)%' THEN 4 WHEN UPPER(TRIM(c.name)) IN ('DISNEY+ CLASSIC','DISNEY+PIXAR','PIXAR CHANNEL') THEN 0 WHEN c.name LIKE '24/7%' OR c.name LIKE '24-7%' THEN 3 WHEN EXISTS(SELECT 1 FROM epg_programmes e WHERE e.epgChannelId=LOWER(TRIM(c.epgChannelId)) AND e.startMs<=:nowMs AND e.stopMs>:nowMs) THEN 1 ELSE 2 END"
+}
