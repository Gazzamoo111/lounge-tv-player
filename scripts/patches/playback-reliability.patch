+package tv.own.owntv.player
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TuneRecoveryTasksTest {
+    private class Clock {
+        var now = 0L
+        val queued = linkedMapOf<Runnable, Long>()
+        val tasks = TuneRecoveryTasks({ r, delay -> queued[r] = now + delay }, { queued.remove(it) })
+        fun advance(ms: Long) {
+            now += ms
+            val due = queued.filterValues { it <= now }.keys.toList()
+            due.forEach { queued.remove(it); it.run() }
+        }
+    }
+
+    @Test fun `superseded reconnect cannot clear replacement tune pending state`() {
+        val c = Clock()
+        var generation = 1L
+        var newTunePending = true
+        val captured = generation
+        val old = c.tasks.post(1500, { generation == captured }) { newTunePending = false }
+        c.tasks.cancelAll()
+        generation++
+        // Simulate a callback that the platform dequeued before removeCallbacks.
+        old.run()
+        c.advance(1500)
+        assertTrue(newTunePending)
+        assertTrue(c.queued.isEmpty())
+    }
+
+    @Test fun `same URL after A B A never revives obsolete session or decoder work`() {
+        val c = Clock()
+        var generation = 1L
+        var url = "A"
+        val firstGeneration = generation
+        var prepares = 0
+        val old = c.tasks.post(2000, { generation == firstGeneration && url == "A" }) { prepares++ }
+        c.tasks.cancelAll(); generation++; url = "B"
+        c.tasks.cancelAll(); generation++; url = "A"
+        val currentGeneration = generation
+        c.tasks.post(500, { generation == currentGeneration && url == "A" }) { prepares++ }
+        old.run(); c.advance(2000)
+        assertEquals(1, prepares)
+    }
+
+    @Test fun `stop and release cancel every recovery type even if URL is unchanged`() {
+        val c = Clock()
+        var prepares = 0
+        val tasks = listOf(500L, 1500L, 2000L).map {
+            c.tasks.post(it, { true }) { prepares++ }
+        }
+        c.tasks.cancelAll()
+        tasks.forEach { it.run() }
+        c.advance(2000)
+        assertEquals(0, prepares)
+    }
+
+    @Test fun `replaced player identity blocks a delayed prepare`() {
+        val c = Clock()
+        var player = Any()
+        val captured = player
+        var prepares = 0
+        c.tasks.post(2000, { player === captured }) { prepares++ }
+        player = Any()
+        c.advance(2000)
+        assertEquals(0, prepares)
+    }
+
+    @Test fun `fast tracking a reconnect runs once and natural recovery remains respected`() {
+        val c = Clock()
+        var playing = false
+        var prepares = 0
+        val r = c.tasks.post(15000, { true }) { if (!playing) prepares++ }
+        r.run(); r.run(); c.advance(15000)
+        assertEquals(1, prepares)
+        c.tasks.post(1500, { true }) { if (!playing) prepares++ }
+        playing = true
+        c.advance(1500)
+        assertEquals(1, prepares)
+    }
+}
