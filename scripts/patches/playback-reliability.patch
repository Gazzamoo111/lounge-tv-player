+package tv.own.owntv.player
+
+/** Main-thread recovery work owned by a tune, including callbacks already dequeued at cancellation. */
+internal class TuneRecoveryTasks(
+    private val schedule: (Runnable, Long) -> Unit,
+    private val remove: (Runnable) -> Unit,
+) {
+    private val pending = mutableSetOf<Runnable>()
+
+    fun post(delayMs: Long, isCurrent: () -> Boolean, action: () -> Unit): Runnable {
+        lateinit var task: Runnable
+        task = Runnable {
+            // Removal is an ownership check too: a cancelled or already-run task is always inert.
+            if (pending.remove(task) && isCurrent()) action()
+        }
+        pending += task
+        schedule(task, delayMs)
+        return task
+    }
+
+    fun cancelAll() {
+        val obsolete = pending.toList()
+        pending.clear()
+        obsolete.forEach(remove)
+    }
+}
