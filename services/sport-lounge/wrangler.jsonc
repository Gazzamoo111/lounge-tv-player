{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loungetv-sport-lounge",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-26",
  "upload_source_maps": true,
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
