{
  "name": "lounge-tv-webos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated LG webOS client of Lounge TV, Android v5.2.3.10 parity work",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node --import ./scripts/ts-loader.mjs --test tests/*.test.ts",
    "test:browser": "playwright test",
    "package": "npm run build && ares-package dist -o artifacts && node scripts/verify-package.mjs",
    "serve": "python3 -m http.server 4173 --directory dist"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@webos-tools/cli": "3.2.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
